# Maintainer: Cx OS <https://github.com/caiquexYT/Cx-OS>
pkgname=cxos-shell
pkgver=1.0.0
pkgrel=1
pkgdesc='Cx OS desktop shell (Quickshell + Hyprland), fork of Caelestia shell'
arch=('x86_64')
url='https://github.com/caiquexYT/Cx-OS'
license=('GPL-3.0-only')
depends=('quickshell-git' 'cxos-cli' 'qt6-base' 'qt6-declarative' 'qt6-imageformats' 'qt6-multimedia'
         'qt6-m3shapes-git' 'ddcutil' 'brightnessctl' 'libcava' 'networkmanager' 'lm_sensors' 'aubio'
         'libpipewire' 'libqalculate' 'power-profiles-daemon' 'ttf-material-symbols-variable'
         'ttf-rubik-vf' 'ttf-cascadia-code-nerd' 'swappy' 'fish' 'bash' 'systemd')
makedepends=('cmake' 'ninja' 'qt6-shadertools')
_src="$startdir/../../shell"

build() {
    cmake -S "$_src" -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        -DVERSION="$pkgver" -DGIT_REVISION="${CXOS_REV:-unknown}" -DDISTRIBUTOR="Cx OS" \
        -DINSTALL_QSCONFDIR=/etc/xdg/quickshell/cxos
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
